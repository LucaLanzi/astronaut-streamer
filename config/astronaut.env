# astronaut-streamer settings, shared by the Pi and the Jetson.
#
# Read by the shell installers and by the Python tools, so keep it to plain
# KEY=value lines: no spaces around '=', no comments on the same line as a
# value.
#
# Put secrets and per-machine overrides in config/astronaut.local.env
# (git-ignored, same format). Values there win over this file, and
# environment variables win over both.

# --- Hotspot: Jetson Wi-Fi <-> Pi ---------------------------------------------
HOTSPOT_SSID=ASTRO-LINK
# Leave empty to be prompted by the installers (8-63 characters).
HOTSPOT_PSK=
# bg = 2.4 GHz, a = 5 GHz
HOTSPOT_BAND=bg
HOTSPOT_CHANNEL=6
WIFI_COUNTRY=US
HOTSPOT_PREFIX_LEN=24
JETSON_HOTSPOT_IP=10.42.0.1
# Fixed Pi address, below NetworkManager's DHCP range (.10-.254)
PI_HOTSPOT_IP=10.42.0.2
# Network interfaces: empty = auto-detect. The Jetson's names differ by model
# (wlan0/eth0 on some, wlP1p1s0/enP8p1s0 on the Orin Nano).
JETSON_HOTSPOT_IFACE=
PI_WIFI_IFACE=

# --- Prism link: Jetson Ethernet <-> ground station ---------------------------
# The JETSON's own address on the ground-station side: what the ground station
# opens in its browser (http://<this>:8080). Not the ground station's address,
# which isn't configured anywhere. Rover: 10.110.0.230. Bench test on a home
# network: the Jetson's home address, e.g. JETSON_GROUND_IP=192.168.4.97 in
# astronaut.local.env.
JETSON_GROUND_IP=10.110.0.230
# Empty = the interface that has JETSON_GROUND_IP
JETSON_GROUND_IFACE=

# --- Stream -------------------------------------------------------------------
STREAM_PATH=astronaut
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2M
# auto = the Pi's hardware encoder if it works, else libx264.
# Or force one: h264_v4l2m2m | libx264
VIDEO_ENCODER=auto
AUDIO_BITRATE=32k
# rtsp (default) or srt (for a lossy link)
TRANSPORT=rtsp
SRT_LATENCY_MS=200

# --- Devices on the Pi (empty = auto-detect) ------------------------------------
# Substring of the camera's /dev/v4l/by-id name, e.g. C920
CAMERA_MATCH=
# Substring of the mic's ALSA card name; empty = the camera's own mic
MIC_MATCH=
# Substring of the USB speaker's ALSA card name; empty = any USB playback
# device that isn't the camera
SPEAKER_MATCH=

# --- Jetson services --------------------------------------------------------------
# Dashboard (Flask). 5000/5001 are F' GDS and 5900 is the spectrometer VNC.
WEB_PORT=8080
RTSP_PORT=8554
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189
HLS_PORT=8888
SRT_PORT=8890
MEDIAMTX_API_PORT=9997
MEDIAMTX_VERSION=v1.21.3
